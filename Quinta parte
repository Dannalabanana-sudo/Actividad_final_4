# Eliminar filas duplicadas
df = df.drop_duplicates()

# Eliminar espacios adicionales en los nombres de países, si existen
df["Entity"] = df["Entity"].str.strip()

# Revisar los países o regiones disponibles
df["Entity"].unique()

# Filtrar los datos del mundo
df_mundo = df[df["Entity"] == "World"].copy()

# Eliminar filas sin emisiones registradas
df_mundo = df_mundo.dropna(subset=["Annual CO₂ emissions"])

# Ordenar por año
df_mundo = df_mundo.sort_values("Year")

