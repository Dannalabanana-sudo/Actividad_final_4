# Seleccionar el último año disponible
ultimo_anio = df["Year"].max()

# Filtrar países, excluyendo regiones agregadas como "World"
df_paises = df[
    (df["Year"] == ultimo_anio) &
    (df["Entity"] != "World")
].copy()

# Eliminar valores nulos
df_paises = df_paises.dropna(subset=["Annual CO₂ emissions"])

# Seleccionar los 10 países con mayores emisiones
top_10 = df_paises.nlargest(
    10,
    "Annual CO₂ emissions"
)

plt.figure(figsize=(12, 6))

sns.barplot(
    data=top_10,
    x="Annual CO₂ emissions",
    y="Entity",
    palette="Reds_r"
)

plt.title(f"Top 10 países con mayores emisiones de CO₂ en {ultimo_anio}")
plt.xlabel("Emisiones anuales de CO₂ (toneladas)")
plt.ylabel("País")
plt.show()
