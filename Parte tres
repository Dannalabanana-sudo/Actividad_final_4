# 1. Inspección inicial de estructura y tipos de datos
print("Dimensiones originales:", df.shape)
print("\nValores nulos por columna:\n", df.isnull().sum())

# 2. Renombrar columnas para facilitar el manejo
# Nota: La 4ta columna suele llamarse 'Annual CO₂ emissions', la estandarizamos
df.columns = ['Entidad', 'Codigo', 'Anio', 'Emisiones_CO2']

# 3. Filtrar regiones agregadas (como 'World', 'Asia', 'Europe') que no tienen código ISO de país,
# conservando únicamente países válidos (código de 3 letras) y el agregado 'World' por separado si se requiere.
df_paises = df[df['Codigo'].notna() & (df['Entidad'] != 'World')].copy()

# 4. Eliminar registros con emisiones nulas o negativas (inconsistencias)
df_paises = df_paises.dropna(subset=['Emisiones_CO2'])
df_paises = df_paises[df_paises['Emisiones_CO2'] >= 0]

# 5. Convertir emisiones de toneladas a millones de toneladas (Mt) para mejor legibilidad
df_paises['Emisiones_Mt'] = df_paises['Emisiones_CO2'] / 1e6

# 6. Filtrar ventana temporal moderna (1950 - actualidad) para evitar sesgos de datos incompletos del siglo XIX
df_limpio = df_paises[df_paises['Anio'] >= 1950].reset_index(drop=True)

print("\nDimensiones después de la limpieza:", df_limpio.shape)
df_limpio.describe()
