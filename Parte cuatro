# Gráfica 1: Evolución histórica comparativa (Colombia vs Potencias)
paises_interes = ['Colombia', 'United States', 'China', 'Germany', 'Brazil']
df_comp = df_limpio[df_limpio['Entidad'].isin(paises_interes)]

plt.figure(figsize=(12, 6))
sns.lineplot(data=df_comp, x='Anio', y='Emisiones_Mt', hue='Entidad', linewidth=2.5)
plt.title('Evolución de Emisiones Anuales de CO₂ (1950 - Actualidad)', fontsize=14, fontweight='bold')
plt.xlabel('Año', fontsize=12)
plt.ylabel('Emisiones de CO₂ (Millones de Toneladas)', fontsize=12)
plt.legend(title='País')
plt.tight_layout()
plt.show()

# Gráfica 2: Top 10 países mayores emisores en el último año registrado
ultimo_anio = df_limpio['Anio'].max()
top_10 = df_limpio[df_limpio['Anio'] == ultimo_anio].nlargest(10, 'Emisiones_Mt')

plt.figure(figsize=(12, 6))
sns.barplot(data=top_10, x='Emisiones_Mt', y='Entidad', palette='viridis')
plt.title(f'Top 10 Países con Mayores Emisiones de CO₂ en {ultimo_anio}', fontsize=14, fontweight='bold')
plt.xlabel('Emisiones de CO₂ (Millones de Toneladas)', fontsize=12)
plt.ylabel('País', fontsize=12)
plt.tight_layout()
plt.show()

# Gráfica 3: Zoom específico a la tendencia de Colombia
df_col = df_limpio[df_limpio['Entidad'] == 'Colombia']

plt.figure(figsize=(12, 5))
plt.fill_between(df_col['Anio'], df_col['Emisiones_Mt'], color="skyblue", alpha=0.4)
plt.plot(df_col['Anio'], df_col['Emisiones_Mt'], color="Slateblue", alpha=0.8, linewidth=2)
plt.title('Trayectoria Histórica de Emisiones de CO₂ en Colombia (1950 - Actualidad)', fontsize=14, fontweight='bold')
plt.xlabel('Año', fontsize=12)
plt.ylabel('Emisiones (Millones de Toneladas)', fontsize=12)
plt.tight_layout()
plt.show()
